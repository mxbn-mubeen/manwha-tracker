    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@manhwa-tracker/shared": "workspace:*",
    "@manhwa-tracker/utils": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.5.0"
