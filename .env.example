# Environment Variables — Manhwa Tracker

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@your-neon-host/manhwa_tracker?sslmode=require

# ── Telegram (MTProto — personal account) ─────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=          # GramJS StringSession — generated on first auth

# ── Telegram Alert Bot ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=        # Get this from @BotFather
# Your own numeric Telegram chat ID — the bot ignores everyone else.
# Find it: message the bot once, then check the server logs for
# "Ignored message from unauthorized chat <id>" and use that number.
ALLOWED_CHAT_ID=

# ── App ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
# Shared secret required on every API request. Generate with: openssl rand -hex 32
# Must be set identically here (server) and as VITE_APP_SECRET in apps/web/.env (frontend).
APP_SECRET=

# ── Optional: Puppeteer fallback for JS-heavy sites ───────
USE_HEADLESS=false