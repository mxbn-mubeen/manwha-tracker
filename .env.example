# ==============================================================================
# MANHWA TRACKER - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT
# ------------------------------------------------------------------------------
# Put these in a `.env` file at the ROOT of the monorepo for local development.

# Database
DATABASE_URL=postgresql://user:password@your-neon-host/manhwa_tracker?sslmode=require

# App Secrets
# Shared secret required on every API request. Generate with: openssl rand -hex 32
APP_SECRET=your_super_secret_key_here
VITE_APP_SECRET=your_super_secret_key_here

# Local URLs (Vite handles proxying to the local API and Worker)
VITE_API_URL=http://localhost:3001
VITE_SYNC_URL=http://localhost:3002

# Telegram (MTProto — personal account for reading channels)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=          # Generated automatically on first successful login

# Telegram Bot (For notifications and commands)
TELEGRAM_BOT_TOKEN=        # Get this from @BotFather
# Your own numeric Telegram chat ID — the bot ignores everyone else.
# Send a message to your bot, check the server logs for "Ignored message from unauthorized chat <id>"
ALLOWED_CHAT_ID=

# Anti-Cloudflare (Optional but recommended)
FLARESOLVERR_URL=http://localhost:8191


# ------------------------------------------------------------------------------
# 2. PRODUCTION DEPLOYMENT
# ------------------------------------------------------------------------------
# When deploying to production (e.g. Vercel and Render), you do NOT use a .env file.
# Instead, copy-paste these exact keys into the environment variable settings of each service.

# --- VERCEL WEB (Frontend) ---
# VITE_API_URL=https://your-api-project.vercel.app
# VITE_SYNC_URL=https://your-worker-project.onrender.com
# VITE_APP_SECRET=your_super_secret_key_here

# --- VERCEL API (Backend) ---
# DATABASE_URL=postgresql://user:password@your-neon-host/manhwa_tracker?sslmode=require
# APP_SECRET=your_super_secret_key_here
# FRONTEND_URL=https://your-web-project.vercel.app

# --- RENDER WORKER (Background Sync & Bot) ---
# DATABASE_URL=postgresql://user:password@your-neon-host/manhwa_tracker?sslmode=require
# APP_SECRET=your_super_secret_key_here
# FRONTEND_URL=https://your-web-project.vercel.app
# TELEGRAM_API_ID=your_api_id
# TELEGRAM_API_HASH=your_api_hash
# TELEGRAM_BOT_TOKEN=your_bot_token
# ALLOWED_CHAT_ID=your_chat_id
# FLARESOLVERR_URL=https://your-flaresolverr-url.onrender.com
# TELEGRAM_SESSION=your_gramjs_session_string