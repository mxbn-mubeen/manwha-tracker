# Environment Variables — Manhwa Tracker

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@your-neon-host/manhwa_tracker?sslmode=require

# ── Telegram (MTProto — personal account) ─────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=          # GramJS StringSession — generated on first auth

# ── Telegram Alert Bot ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=        # Get this from @BotFather

# ── App ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ── Optional: Puppeteer fallback for JS-heavy sites ───────
USE_HEADLESS=false
